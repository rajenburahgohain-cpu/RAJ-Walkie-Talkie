<!DOCTYPE html>
<html lang="as">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>RAJ Walkie Talkie</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*{box-sizing:border-box;font-family:Arial,"Noto Sans Assamese",sans-serif}
body{margin:0;background:#f2f6fb;color:#17202a}
header{background:linear-gradient(135deg,#123c69,#087f8c);color:#fff;padding:22px 16px;text-align:center}
header h1{margin:0;font-size:26px} header p{margin:7px 0 0;opacity:.9}
main{max-width:650px;margin:auto;padding:18px}.card{background:#fff;border-radius:16px;padding:20px;margin-bottom:18px;box-shadow:0 5px 18px rgba(0,0,0,.08)}
h2{margin-top:0} input{width:100%;padding:13px;margin:8px 0;border:1px solid #ccd6df;border-radius:10px;font-size:16px}
button{width:100%;padding:13px;margin-top:9px;border:0;border-radius:10px;background:#087f8c;color:#fff;font-size:16px;cursor:pointer}
button.secondary{background:#365f7d} button.danger{background:#b83232}
button.ptt{height:150px;border-radius:50%;max-width:260px;display:block;margin:18px auto;font-size:25px;font-weight:bold;background:#123c69;box-shadow:0 8px 20px rgba(18,60,105,.25);touch-action:none;user-select:none}
button.ptt.talking{background:#b83232;transform:scale(1.03)}
.hidden{display:none}.status{padding:10px;margin-top:10px;border-radius:9px;background:#eef5f8}
.code{font-size:25px;font-weight:bold;text-align:center;padding:15px;border-radius:12px;background:#eef8f8;letter-spacing:2px;word-break:break-all}
.member{padding:12px;border-bottom:1px solid #eee}.small{font-size:13px;color:#667}
.plan{font-size:13px;color:#53606b;background:#f7fafc;padding:10px;border-radius:10px}
.officeBtn{margin-top:8px;text-align:left;background:#f0f7f8;color:#123c69;border:1px solid #d7e8ea}
.voiceState{text-align:center;font-weight:bold;font-size:17px}
</style>
<style>.planPanel{margin-top:14px;padding:14px;border:1px solid #d7e8ea;border-radius:12px;background:#f8fbfc}.planGrid{display:grid;gap:10px}.adminOnly{border-left:4px solid #123c69}</style>
</head>
<body>
<header><h1>📻 RAJ Walkie Talkie</h1><p>Private Office Communication</p></header>
<main>

<section id="loginSection" class="card">
<h2>🔐 Login</h2>
<input id="email" type="email" placeholder="Email" autocomplete="email">
<input id="password" type="password" placeholder="Password" autocomplete="current-password">
<button onclick="login()">Login</button>
<div id="loginStatus" class="status"></div>
</section>

<section id="appSection" class="hidden">
<div class="card">
<h2>👤 Account</h2>
<div id="userEmail" class="small"></div>
<button class="danger" onclick="logout()">Logout</button>
</div>

<div class="card">
<h2>🏢 Create Office</h2>
<input id="officeName" type="text" placeholder="Office নাম">
<button onclick="createOffice()">Create Office</button>
<div id="createStatus" class="status"></div>
</div>

<div class="card">
<h2>🔗 Join Office</h2>
<input id="joinCode" type="text" placeholder="RAJ-XXXXXXXX" autocomplete="off">
<button onclick="joinOffice()">Join with Link Code</button>
<div id="joinStatus" class="status"></div>
</div>

<div class="card">
<h2>🏢 My Offices</h2>
<div id="officeList">Loading...</div>
</div>

<div id="voiceCard" class="card hidden">
<h2>📻 Office Voice</h2>
<div id="selectedOffice" class="small"></div>
<div id="voiceStatus" class="status voiceState">Voice বন্ধ</div>
<button id="listenBtn" class="secondary hidden" onclick="enableSpeaker()">🔊 Voice শুনিবলৈ টিপক</button>
<button id="pttBtn" class="ptt hidden">PRESS & HOLD<br>TO TALK</button>
<div class="plan">🎙️ Direct PTT: বুটাম টিপি ধৰি কথা কওক। বুটাম এৰি দিলে কথা বন্ধ হৈ আনসকলে শুনিব পাৰিব।</div>
<audio id="remoteAudio" autoplay playsinline></audio>
<div id="groupAdminPanel" class="planPanel adminOnly hidden">
<h3>👑 Group Admin Panel</h3>
<div id="planInfo" class="small">Loading plan...</div>
<div class="planGrid">
<label>Plan<select id="planSelect"><option value="free">Free — ₹0/month — 10 users — Ads</option><option value="premium">Premium — ₹49/month — 50 users — No Ads</option><option value="business">Business — Custom — No Ads</option></select></label>
<label id="customPriceWrap" class="hidden">Business monthly charge (₹)<input id="customPrice" type="number" min="0" step="1" placeholder="যেনে 299"></label>
<label id="customLimitWrap" class="hidden">Business maximum users/group<input id="customLimit" type="number" min="1" step="1" placeholder="যেনে 100"></label>
<button onclick="saveGroupPlan()">💾 Save Group Plan</button><div id="planStatus" class="status"></div>
</div></div>
</div>
</section>
</main>

<script>
const SUPABASE_URL="https://nxpagmvyoylhtprzccxs.supabase.co";
const SUPABASE_PUBLISHABLE_KEY="sb_publishable_AT6zontM3G2V3a0dYfzaBQ_nq6K4ozm";
const supabaseClient=window.supabase.createClient(SUPABASE_URL,SUPABASE_PUBLISHABLE_KEY);

let currentUser=null;
let offices=[];
let selectedOffice=null;
let voiceChannel=null;
let localStream=null;
let localAudioTrack=null;
let peers=new Map();
let candidateQueues=new Map();
let helloTimer=null;
let announcedPeers=new Set();
let remoteStream=null;

function setStatus(id,message){
  const el=document.getElementById(id);
  if(el) el.innerHTML=message;
}
function escapeHtml(value){
  return String(value??"").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;").replaceAll('"',"&quot;").replaceAll("'","&#039;");
}

async function login(){
  const email=document.getElementById("email").value.trim();
  const password=document.getElementById("password").value;
  if(!email||!password){setStatus("loginStatus","❌ Email আৰু Password দিয়ক।");return;}
  setStatus("loginStatus","🔐 Login কৰি থকা হৈছে...");
  const {data,error}=await supabaseClient.auth.signInWithPassword({email,password});
  if(error){setStatus("loginStatus","❌ Login ব্যর্থ: "+escapeHtml(error.message));return;}
  if(!data.session){setStatus("loginStatus","❌ Login session পোৱা নগ'ল।");return;}
  showApp(data.session.user);
}

async function logout(){
  await disconnectVoice();
  await supabaseClient.auth.signOut();
  currentUser=null; offices=[]; selectedOffice=null;
  document.getElementById("appSection").classList.add("hidden");
  document.getElementById("loginSection").classList.remove("hidden");
  setStatus("loginStatus","✅ Logout সফল।");
}

function showApp(user){
  currentUser=user;
  document.getElementById("loginSection").classList.add("hidden");
  document.getElementById("appSection").classList.remove("hidden");
  document.getElementById("userEmail").textContent="Login: "+(user.email||"");
  loadOffices();
}

async function createOffice(){
  const name=document.getElementById("officeName").value.trim();
  if(!name){setStatus("createStatus","❌ Office নাম দিয়ক।");return;}
  setStatus("createStatus","🏢 Office সৃষ্টি কৰি থকা হৈছে...");
  const {data,error}=await supabaseClient.rpc("create_office",{p_name:name});
  if(error){setStatus("createStatus","❌ সমস্যা: "+escapeHtml(error.message));return;}
  const office=Array.isArray(data)?data[0]:data;
  if(!office){setStatus("createStatus","❌ Office data পোৱা নগ'ল।");return;}
  setStatus("createStatus",`<b>✅ Office সৃষ্টি সফল!</b><br><br>Office: ${escapeHtml(office.name)}<br><br><div class="code">${escapeHtml(office.link_code)}</div><br>এই Code-টো সদস্যসকলক Join কৰিবলৈ দিব পাৰিব।`);
  document.getElementById("officeName").value="";
  loadOffices();
}

async function joinOffice(){
  const code=document.getElementById("joinCode").value.trim();
  if(!code){setStatus("joinStatus","❌ Link Code দিয়ক।");return;}
  setStatus("joinStatus","🔗 Office-ত Join কৰি থকা হৈছে...");
  const {data,error}=await supabaseClient.rpc("join_office",{p_link_code:code});
  if(error){setStatus("joinStatus","❌ Join ব্যর্থ: "+escapeHtml(error.message));return;}
  const office=Array.isArray(data)?data[0]:data;
  setStatus("joinStatus",`✅ Join সফল!<br><br>Office: <b>${escapeHtml(office.name)}</b>`);
  document.getElementById("joinCode").value="";
  loadOffices();
}

async function loadOffices(){
  const list=document.getElementById("officeList");
  list.innerHTML="Loading...";
  const {data,error}=await supabaseClient.rpc("get_my_offices");
  if(error){list.innerHTML="❌ "+escapeHtml(error.message);return;}
  offices=data||[];
  if(!offices.length){
    list.innerHTML="এতিয়াও কোনো Office-ত Join কৰা হোৱা নাই।";
    document.getElementById("voiceCard").classList.add("hidden");
    return;
  }
  list.innerHTML="";
  offices.forEach((office,index)=>{
    const div=document.createElement("div");
    div.className="member";
    const b=document.createElement("button");
    b.className="officeBtn";
    b.textContent="🏢 "+office.office_name+"  •  "+office.role;
    b.onclick=()=>selectOffice(office);
    div.appendChild(b);
    const code=document.createElement("div");
    code.className="code"; code.textContent=office.link_code;
    div.appendChild(code);
    list.appendChild(div);
    if(index===0 && !selectedOffice) selectOffice(office);
  });
}

function selectOffice(office){
  selectedOffice=office;
  document.getElementById("voiceCard").classList.remove("hidden");
  document.getElementById("selectedOffice").textContent="Selected: "+office.office_name;
  document.getElementById("pttBtn").classList.remove("hidden");
  loadGroupPlan();
}

async function connectVoice(){
  if(!selectedOffice){
    setVoiceState("❌ প্ৰথমে এটা Office বাছক।");
    return false;
  }
  if(voiceChannel && localStream){
    return true;
  }

  const btn=document.getElementById("pttBtn");

  try{
    if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
      throw new Error("এই browser-ত microphone access নাই। HTTPS page-ত Chrome ব্যৱহাৰ কৰক।");
    }

    localStream=await navigator.mediaDevices.getUserMedia({
      audio:{
        echoCancellation:true,
        noiseSuppression:true,
        autoGainControl:true
      },
      video:false
    });

    localAudioTrack=localStream.getAudioTracks()[0];
    localAudioTrack.enabled=false;

    const topic="office:"+selectedOffice.office_id;
    voiceChannel=supabaseClient.channel(topic,{config:{private:true}});

    voiceChannel
      .on("broadcast",{event:"hello"},({payload})=>handleHello(payload))
      .on("broadcast",{event:"offer"},({payload})=>handleOffer(payload))
      .on("broadcast",{event:"answer"},({payload})=>handleAnswer(payload))
      .on("broadcast",{event:"candidate"},({payload})=>handleCandidate(payload))
      .on("broadcast",{event:"bye"},({payload})=>handleBye(payload));

    voiceChannel.subscribe(async status=>{
      if(status==="SUBSCRIBED"){
        setVoiceState("🟢 Voice connected — PTT ready");
        btn.classList.add("hidden");
        document.getElementById("pttBtn").classList.remove("hidden");

        await sendSignal("hello",{from:currentUser.id});

        clearInterval(helloTimer);
        helloTimer=setInterval(async ()=>{
          if(voiceChannel){
            await sendSignal("hello",{from:currentUser.id});
          }
        },2000);

      }else if(status==="CHANNEL_ERROR" || status==="TIMED_OUT"){
        setVoiceState("❌ Voice channel connection failed");
        btn.disabled=false;
        btn.textContent="🎙️ Voice পুনৰ চালু কৰক";
      }
    });

    return true;
  }catch(e){
    btn.classList.remove("talking");
    btn.innerHTML="PRESS & HOLD<br>TO TALK";
    if(localStream){
      localStream.getTracks().forEach(t=>t.stop());
      localStream=null;
    }
    localAudioTrack=null;
    setVoiceState("❌ Microphone সমস্যা: "+escapeHtml(e.message));
    return false;
  }
}

function setVoiceState(text){
  document.getElementById("voiceStatus").textContent=text;
}

async function sendSignal(event,payload){
  if(!voiceChannel)return;
  try{
    await voiceChannel.send({
      type:"broadcast",
      event,
      payload
    });
  }catch(e){}
}

function createPeer(remoteId){
  if(peers.has(remoteId)) return peers.get(remoteId);

  const pc=new RTCPeerConnection({
    iceServers:[
      {urls:"stun:stun.l.google.com:19302"},
      {urls:"stun:stun1.l.google.com:19302"}
    ]
  });

  if(localStream){
    localStream.getTracks().forEach(track=>{
      pc.addTrack(track,localStream);
    });
  }

  pc.onicecandidate=e=>{
    if(e.candidate){
      sendSignal("candidate",{
        from:currentUser.id,
        to:remoteId,
        candidate:e.candidate
      });
    }
  };

  pc.ontrack=e=>{
    const audio=document.getElementById("remoteAudio");

    if(!remoteStream){
      remoteStream=new MediaStream();
    }

    if(e.track && !remoteStream.getTracks().some(t=>t.id===e.track.id)){
      remoteStream.addTrack(e.track);
    }

    audio.srcObject=remoteStream;
    audio.autoplay=true;
    audio.playsInline=true;
    audio.muted=false;
    audio.volume=1;

    audio.play().then(()=>{
      document.getElementById("listenBtn").classList.add("hidden");
      setVoiceState("🟢 Audio received — PTT ready");
    }).catch(()=>{
      document.getElementById("listenBtn").classList.remove("hidden");
      setVoiceState("🔊 Voice আহিছে — শুনিবলৈ Speaker button টিপক");
    });
  };

  pc.oniceconnectionstatechange=()=>{
    const s=pc.iceConnectionState;
    if(s==="checking"){
      setVoiceState("🟡 দুটা ফোন connect কৰি থকা হৈছে...");
    }else if(s==="connected" || s==="completed"){
      setVoiceState("🟢 Phone-to-phone audio connected");
    }else if(s==="failed"){
      setVoiceState("❌ Phone-to-phone connection failed — TURN server লাগিব পাৰে");
      removePeer(remoteId);
    }
  };

  pc.onconnectionstatechange=()=>{
    const s=pc.connectionState;
    if(s==="connected"){
      setVoiceState("🟢 Phone-to-phone audio connected");
    }else if(s==="failed"){
      setVoiceState("❌ WebRTC connection failed — mobile network NAT সমস্যা হ'ব পাৰে");
    }else if(s==="disconnected"){
      setVoiceState("🟡 Phone connection temporarily disconnected");
    }
  };

  peers.set(remoteId,pc);
  candidateQueues.set(remoteId,[]);
  return pc;
}

async function handleHello(p){
  if(!p || !p.from || p.from===currentUser.id)return;

  const remoteId=p.from;
  let pc=peers.get(remoteId);

  if(!pc || pc.connectionState==="failed" || pc.connectionState==="closed"){
    removePeer(remoteId);
    pc=createPeer(remoteId);
    announcedPeers.delete(remoteId);
  }

  // Only the lexicographically smaller user creates the offer.
  // Repeated hello messages allow recovery if an earlier offer was lost.
  if(currentUser.id < remoteId){
    if(pc.signalingState!=="stable") return;

    const offer=await pc.createOffer({
      offerToReceiveAudio:true
    });

    await pc.setLocalDescription(offer);

    await sendSignal("offer",{
      from:currentUser.id,
      to:remoteId,
      description:pc.localDescription
    });

    announcedPeers.add(remoteId);
  }
}

async function handleOffer(p){
  if(!p || p.to!==currentUser.id || !p.from || !p.description)return;

  let pc=peers.get(p.from);

  if(!pc || pc.connectionState==="failed" || pc.connectionState==="closed"){
    removePeer(p.from);
    pc=createPeer(p.from);
  }

  try{
    await pc.setRemoteDescription(new RTCSessionDescription(p.description));
    await flushCandidates(p.from);

    const answer=await pc.createAnswer();
    await pc.setLocalDescription(answer);

    await sendSignal("answer",{
      from:currentUser.id,
      to:p.from,
      description:pc.localDescription
    });
  }catch(e){
    setVoiceState("❌ Offer/Answer error: "+escapeHtml(e.message));
  }
}

async function handleAnswer(p){
  if(!p || p.to!==currentUser.id || !p.from || !p.description)return;

  const pc=peers.get(p.from);
  if(!pc)return;

  try{
    if(pc.signalingState!=="have-local-offer")return;

    await pc.setRemoteDescription(new RTCSessionDescription(p.description));
    await flushCandidates(p.from);
  }catch(e){
    setVoiceState("❌ Answer error: "+escapeHtml(e.message));
  }
}

async function handleCandidate(p){
  if(!p || p.to!==currentUser.id || !p.from || !p.candidate)return;

  const pc=peers.get(p.from)||createPeer(p.from);

  if(pc.remoteDescription && pc.remoteDescription.type){
    try{
      await pc.addIceCandidate(new RTCIceCandidate(p.candidate));
    }catch(e){}
  }else{
    if(!candidateQueues.has(p.from))candidateQueues.set(p.from,[]);
    candidateQueues.get(p.from).push(p.candidate);
  }
}

async function flushCandidates(remoteId){
  const pc=peers.get(remoteId);
  if(!pc)return;

  const q=candidateQueues.get(remoteId)||[];

  for(const c of q){
    try{
      await pc.addIceCandidate(new RTCIceCandidate(c));
    }catch(e){}
  }

  candidateQueues.set(remoteId,[]);
}

function handleBye(p){
  if(p?.from){
    announcedPeers.delete(p.from);
    removePeer(p.from);
  }
}

function enableSpeaker(){
  const audio=document.getElementById("remoteAudio");
  audio.muted=false;
  audio.volume=1;

  audio.play().then(()=>{
    document.getElementById("listenBtn").classList.add("hidden");
    setVoiceState("🟢 Speaker চালু — PTT ready");
  }).catch(()=>{
    setVoiceState("❌ Speaker চালু কৰিব পৰা নগ'ল");
  });
}

function removePeer(remoteId){
  const pc=peers.get(remoteId);
  if(pc){
    try{pc.close();}catch(e){}
  }
  peers.delete(remoteId);
  candidateQueues.delete(remoteId);
}

let pttHeld=false;
let pttStarting=false;

async function startTalking(e){
  if(e)e.preventDefault();

  pttHeld=true;

  const b=document.getElementById("pttBtn");

  if(!localAudioTrack){
    if(pttStarting)return;

    pttStarting=true;
    b.classList.add("talking");
    b.innerHTML="🟡 CONNECTING...<br>PLEASE HOLD";
    setVoiceState("🎙️ Voice connecting — microphone permission may appear...");

    const ok=await connectVoice();

    pttStarting=false;

    if(!ok || !localAudioTrack){
      b.classList.remove("talking");
      b.innerHTML="PRESS & HOLD<br>TO TALK";
      pttHeld=false;
      return;
    }

    if(!pttHeld)return;
  }

  localAudioTrack.enabled=true;
  b.classList.add("talking");
  b.innerHTML="🔴 TALKING<br>RELEASE";
  setVoiceState("🔴 আপুনি কথা কৈ আছে...");
}

function stopTalking(e){
  if(e)e.preventDefault();

  pttHeld=false;

  if(!localAudioTrack)return;

  localAudioTrack.enabled=false;

  const b=document.getElementById("pttBtn");
  b.classList.remove("talking");
  b.innerHTML="PRESS & HOLD<br>TO TALK";

  if(peers.size){
    setVoiceState("🟢 Phone-to-phone audio connected — PTT ready");
  }else{
    setVoiceState(voiceChannel ? "🟢 Voice connected — waiting for another phone" : "Voice বন্ধ");
  }
}

const ptt=document.getElementById("pttBtn");

ptt.addEventListener("pointerdown",startTalking,{passive:false});
["pointerup","pointercancel","pointerleave"].forEach(ev=>{
  ptt.addEventListener(ev,stopTalking,{passive:false});
});
ptt.addEventListener("contextmenu",e=>e.preventDefault());

async function disconnectVoice(){
  clearInterval(helloTimer);
  helloTimer=null;
  if(voiceChannel){
    try{await sendSignal("bye",{from:currentUser?.id});}catch(e){}
    try{await supabaseClient.removeChannel(voiceChannel);}catch(e){}
  }
  voiceChannel=null;
  peers.forEach(pc=>pc.close()); peers.clear(); candidateQueues.clear(); announcedPeers.clear();
  remoteStream=null;
  const listenBtn=document.getElementById("listenBtn");
  if(listenBtn) listenBtn.classList.add("hidden");
  if(localStream){localStream.getTracks().forEach(t=>t.stop());}
  localStream=null; localAudioTrack=null;
  const btn=document.getElementById("connectVoiceBtn");
  if(btn){btn.classList.remove("hidden");btn.disabled=false;btn.textContent="🎙️ Voice চালু কৰক";}
  const p=document.getElementById("pttBtn");
  if(p){p.classList.add("hidden");p.classList.remove("talking");p.innerHTML="PRESS & HOLD<br>TO TALK";}
}

async function checkSession(){
  const {data:{session}}=await supabaseClient.auth.getSession();
  if(session) showApp(session.user);
}
checkSession();


function isGroupAdmin(office){return office && (office.role === "owner" || office.role === "admin");}
function toggleBusinessFields(){const b=document.getElementById("planSelect")?.value==="business";document.getElementById("customPriceWrap")?.classList.toggle("hidden",!b);document.getElementById("customLimitWrap")?.classList.toggle("hidden",!b);}
document.getElementById("planSelect")?.addEventListener("change",toggleBusinessFields);
async function loadGroupPlan(){
 if(!selectedOffice)return; const panel=document.getElementById("groupAdminPanel");
 if(!isGroupAdmin(selectedOffice)){panel.classList.add("hidden");return;} panel.classList.remove("hidden");
 const {data,error}=await supabaseClient.rpc("get_group_plan",{p_group_id:selectedOffice.office_id});
 if(error){document.getElementById("planInfo").textContent="❌ "+error.message;return;}
 const plan=data?.[0]; if(!plan){document.getElementById("planInfo").textContent="Plan information পোৱা নগ'ল।";return;}
 document.getElementById("planSelect").value=plan.plan_code; document.getElementById("customPrice").value=plan.custom_price??""; document.getElementById("customLimit").value=plan.custom_limit??"";
 document.getElementById("planInfo").textContent=`Current: ${plan.plan_name} • ₹${plan.monthly_price}/month • Maximum users: ${plan.max_users} • Ads: ${plan.ads_enabled?"ON":"OFF"}`; toggleBusinessFields();
}
async function saveGroupPlan(){
 if(!selectedOffice||!isGroupAdmin(selectedOffice)){setStatus("planStatus","❌ কেৱল Group Admin-এ plan সলনি কৰিব পাৰে।");return;}
 const code=document.getElementById("planSelect").value; let price=null,limit=null,ads=(code==="free");
 if(code==="business"){price=Number(document.getElementById("customPrice").value);limit=Number(document.getElementById("customLimit").value);if(!Number.isFinite(price)||price<0){setStatus("planStatus","❌ Business monthly charge সঠিককৈ দিয়ক।");return;}if(!Number.isInteger(limit)||limit<1){setStatus("planStatus","❌ Business user limit সঠিককৈ দিয়ক।");return;}}
 setStatus("planStatus","💾 Save কৰি থকা হৈছে...");
 const {error}=await supabaseClient.from("group_settings").update({plan_code:code,custom_monthly_price:price,custom_user_limit:limit,ads_enabled:ads,updated_at:new Date().toISOString()}).eq("group_id",selectedOffice.office_id);
 if(error){setStatus("planStatus","❌ Save ব্যর্থ: "+escapeHtml(error.message));return;} setStatus("planStatus","✅ Group plan সফলভাৱে update হৈছে।"); await loadGroupPlan();
}
</script>
</body>
</html>
